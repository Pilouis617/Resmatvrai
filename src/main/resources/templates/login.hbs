{{> /include/header}}
<section class="form-card login-card">
    <p class="eyebrow">Bienvenue</p>
    <h1>Connexion</h1>
    <p class="form-intro">Connecte-toi pour réserver du matériel.</p>

    {{#erreurConnexion}}
        <div class="alert alert-error">Identifiant ou mot de passe incorrect.</div>
    {{/erreurConnexion}}
    {{#deconnecte}}
        <div class="alert alert-success">Tu es bien déconnecté.</div>
    {{/deconnecte}}

    <form action="/login" method="post">
        <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
        <div class="form-group">
            <label for="username">Identifiant</label>
            <input id="username" name="username" autocomplete="username" required autofocus>
        </div>
        <div class="form-group">
            <label for="password">Mot de passe</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button type="submit">Se connecter</button>
    </form>

    <p class="field-help login-demo">
        Comptes de démonstration : <strong>etudiant</strong> ou <strong>gestionnaire</strong>,
        mot de passe <strong>Demo123!</strong>
    </p>
</section>
{{> /include/footer}}
