{{> /include/header}}
<div class="page-heading">
    <div>
        <p class="eyebrow">Mon espace</p>
        <h1>Mes réservations</h1>
        <p>Suis l'état de tes demandes et de tes emprunts.</p>
    </div>
    <a class="button" href="/catalogue">Nouvelle réservation</a>
</div>

{{^reservations}}
    <div class="empty-state">
        <h2>Aucune réservation</h2>
        <p>Tu n'as encore fait aucune demande.</p>
        <a class="button" href="/catalogue">Voir le catalogue</a>
    </div>
{{/reservations}}

{{#aDesReservations}}
<div class="table-wrap">
    <table>
        <thead>
        <tr>
            <th scope="col">Matériel</th>
            <th scope="col">Période</th>
            <th scope="col">Statut</th>
            <th scope="col">Détails</th>
            <th scope="col">Actions</th>
        </tr>
        </thead>
        <tbody>
        {{#reservations}}
            <tr>
                <td>
                    <strong>{{typeMateriel.nom}}</strong>
                    <br><span class="field-help">Demandée le {{dateDemandeFr}}</span>
                </td>
                <td>du {{dateDebutFr}}<br>au {{dateFinFr}}</td>
                <td><span class="badge {{statutClasse}}">{{statut}}</span></td>
                <td>
                    {{#motifDecision}}<span class="field-help">{{motifDecision}}</span><br>{{/motifDecision}}
                    {{#emprunt}}
                        <span class="field-help">Exemplaire : {{materiel.nom}}</span>
                        {{#enRetard}}<br><span class="badge badge-late">En retard</span>{{/enRetard}}
                        {{#dateRetour}}<br><span class="field-help">Rendu le {{dateRetourFr}}</span>{{/dateRetour}}
                    {{/emprunt}}
                </td>
                <td>
                    {{#enAttente}}
                        <form action="/reservations/{{id}}/annuler" method="post">
                            <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                            <button class="button-danger button-small" type="submit">Annuler</button>
                        </form>
                    {{/enAttente}}
                </td>
            </tr>
        {{/reservations}}
        </tbody>
    </table>
</div>
{{/aDesReservations}}
{{> /include/footer}}
