<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ResMat</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/catalogue">
            <span class="brand-mark">R</span>
            <span>ResMat</span>
        </a>
        {{#utilisateur}}
            <nav class="main-nav site-nav">
                <a href="/catalogue" {{#navCatalogue}}class="active"{{/navCatalogue}}>Catalogue</a>
                <a href="/reservations" {{#navReservations}}class="active"{{/navReservations}}>Mes réservations</a>
                {{#estGestionnaire}}
                    <a href="/gestion" {{#navGestion}}class="active"{{/navGestion}}>Gestion</a>
                    <a href="/types-materiel" {{#navTypes}}class="active"{{/navTypes}}>Types de matériel</a>
                {{/estGestionnaire}}
            </nav>
            <div class="header-user">
                <span class="field-help">{{prenom}} {{nom}}</span>
                <form action="/logout" method="post">
                    <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                    <button class="button-secondary button-small" type="submit">Déconnexion</button>
                </form>
            </div>
        {{/utilisateur}}
    </div>
</header>
<main class="container">
    {{#message}}
        <div class="alert alert-success">{{message}}</div>
    {{/message}}
    {{#erreur}}
        <div class="alert alert-error">{{erreur}}</div>
    {{/erreur}}
