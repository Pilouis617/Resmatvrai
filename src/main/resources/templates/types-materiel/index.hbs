{{> /include/header}}
<div class="page-heading">
    <div>
        <p class="eyebrow">Espace gestionnaire</p>
        <h1>Types de matériel</h1>
        <p>Gère les modèles proposés à la réservation.</p>
    </div>
    <a class="button" href="/types-materiel/nouveau">Ajouter un type de matériel</a>
</div>

{{^aucunType}}
    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th scope="col">Nom</th>
                <th scope="col">Catégorie</th>
                <th scope="col">Durée maximale</th>
                <th scope="col">Exemplaires</th>
                <th scope="col">Catalogue</th>
                <th scope="col">Actions</th>
            </tr>
            </thead>

            <tbody>
            {{#types}}
                <tr>
                    <td>
                        <strong>{{nom}}</strong>
                        {{#description}}
                            <br>
                            <span class="field-help">{{description}}</span>
                        {{/description}}
                    </td>
                    <td>{{categorie.libelle}}</td>
                    <td>{{dureeMaxTexte}}</td>
                    <td>{{nbExemplaires}}</td>
                    <td>
                        {{#auCatalogue}}
                            <span class="badge badge-available">Au catalogue</span>
                        {{/auCatalogue}}
                        {{^auCatalogue}}
                            <span class="badge badge-unavailable">Retiré</span>
                        {{/auCatalogue}}
                    </td>
                    <td>
                        <div class="actions-stack">
                            <a class="button button-secondary button-small" href="/types-materiel/{{id}}/modifier">
                                Modifier
                            </a>
                            <form action="/types-materiel/{{id}}/catalogue" method="post">
                                <input type="hidden" name="{{csrfParameterName}}" value="{{csrfToken}}">
                                {{#auCatalogue}}
                                    <input type="hidden" name="auCatalogue" value="false">
                                    <button class="button-danger button-small" type="submit">Retirer</button>
                                {{/auCatalogue}}
                                {{^auCatalogue}}
                                    <input type="hidden" name="auCatalogue" value="true">
                                    <button class="button-small" type="submit">Remettre</button>
                                {{/auCatalogue}}
                            </form>
                        </div>
                    </td>
                </tr>
            {{/types}}
            </tbody>
        </table>
    </div>
{{/aucunType}}

{{#aucunType}}
    <div class="empty-state">
        <h2>Aucun type de matériel</h2>
        <p>Tu peux ajouter un type de matériel pour commencer à compléter le catalogue.</p>
        <a class="button" href="/types-materiel/nouveau">
            Ajouter un type de matériel
        </a>
    </div>
{{/aucunType}}
{{> /include/footer}}
